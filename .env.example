# ── Environment for Gold 1-Hour SMA Breakdown (SHORT) ──
# Copy to .env and fill in. NEVER commit .env.

# ── Delta Exchange API (India) ──
# https://app.india.delta.exchange → Settings → API Management (Trading permission, whitelist server IP)
DELTA_API_KEY=
DELTA_API_SECRET=
# DELTA_BASE_URL=https://api.india.delta.exchange
# Testnet: DELTA_BASE_URL=https://cdn-ind.testnet.deltaex.org

# ── Telegram ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Trading Mode ── PAPER (default) | LIVE
TRADING_MODE=PAPER
